# Copy to .env.local for local overrides. Vite only exposes VITE_-prefixed variables.

# Where the browser sends API calls. The relative default is served by the Vite dev proxy in
# development and by nginx in the container, so one build works in both.
VITE_API_BASE_URL=/api

# Where the dev server forwards /api. Build-time only, never shipped to the browser.
VITE_DEV_API_PROXY=http://localhost:8080
