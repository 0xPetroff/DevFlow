# Copy to .env and replace every placeholder before running docker compose.
# Generate secrets with: openssl rand -base64 48

POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=change-me-local-only
# Host port only. 5432 is often already taken by a local PostgreSQL install.
POSTGRES_PORT=5433

# The containers are a deployment, so they run the prod profile. `make backend-run` runs the
# API on the host under dev, which adds debug logging and the seed migration location.
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080

# Must be at least 32 bytes once base64-decoded; the app refuses to start otherwise.
DEVFLOW_JWT_SECRET=replace-with-openssl-rand-base64-48
DEVFLOW_JWT_ACCESS_TOKEN_MINUTES=15
DEVFLOW_JWT_REFRESH_TOKEN_DAYS=7

DEVFLOW_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Ports under 1024 need root, which Colima's port forwarding does not have.
FRONTEND_PORT=8081
# Baked into the bundle at image build time. The relative path is served by the same nginx that
# serves the app, so the browser makes no cross-origin request and needs no CORS grant.
VITE_API_BASE_URL=/api

# The public demo only. Set VITE_DEMO_MODE=true and add the demo profile
# (SPRING_PROFILES_ACTIVE=prod,demo) to load seeded projects, issues and release history, and to
# print the seeded credentials on the login page. Never set either on a real installation: the
# seed creates an administrator whose password is published in the README.
VITE_DEMO_MODE=

# Read by ci/scripts/devflow-deployment.sh. The pipeline takes these from GitHub secrets and
# variables; they are here for running the scripts by hand against a local stack. The URL
# includes /api, because the scripts append paths to it.
DEVFLOW_API_URL=http://localhost:8080/api
DEVFLOW_API_KEY=
DEVFLOW_PROJECT_ID=
